{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://problems.atomi.cloud/schema/v1/problems.schema.json",
  "title": "Problem definitions (problemgen v1)",
  "description": "One file per (module, version) of a service (kind ProblemSet), or a shared library of definitions (kind ProblemLibrary). Structural rules only; semantic rules (placeholders, privacy, clashes, cycles) are enforced by `problemgen lint`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "problems"],
  "properties": {
    "apiVersion": { "const": "problems.atomi.cloud/v1" },
    "kind": { "enum": ["ProblemSet", "ProblemLibrary"] },
    "module": {
      "description": "The module segment of the type address. Required for a ProblemSet, forbidden in a ProblemLibrary.",
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "version": {
      "description": "Contract version of this module's problems. A new version is a new file.",
      "type": "string",
      "pattern": "^v[0-9]+$",
      "maxLength": 16
    },
    "name": {
      "description": "Name of a ProblemLibrary (documentation only).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "imports": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/importSource" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["from"],
            "properties": {
              "from": { "$ref": "#/$defs/importSource" },
              "only": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/problemId" }
              }
            }
          }
        ]
      }
    },
    "types": {
      "description": "Named enum and object types. Nested objects and enums must be named here.",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Za-z0-9]*$", "maxLength": 64 },
      "additionalProperties": { "$ref": "#/$defs/namedType" }
    },
    "problems": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/problemId" },
      "maxProperties": 1024,
      "additionalProperties": { "$ref": "#/$defs/problem" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "ProblemSet" } } },
      "then": { "required": ["module", "version"], "not": { "required": ["name"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "ProblemLibrary" } } },
      "then": {
        "required": ["name"],
        "allOf": [{ "not": { "required": ["module"] } }, { "not": { "required": ["version"] } }]
      }
    }
  ],
  "$defs": {
    "importSource": {
      "description": "builtin:<name> (shipped inside problemgen, e.g. builtin:generic/v1) or a relative path to a ProblemLibrary file.",
      "type": "string",
      "pattern": "^(builtin:[a-z0-9/-]+|\\.{1,2}/[^\\s]+\\.ya?ml)$"
    },
    "problemId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
      "maxLength": 63
    },
    "fieldName": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*$",
      "maxLength": 64
    },
    "text": {
      "description": "Plain text. No control characters.",
      "type": "string",
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "deprecated": {
      "description": "Why, and what to use instead. Presence marks the item deprecated.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "status", "recoverable", "detail"],
      "properties": {
        "title": {
          "description": "Fixed title (RFC 9457 `title`). Never templated.",
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[^{}\\x00-\\x1f\\x7f]+$"
        },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "recoverable": { "type": "boolean" },
        "detail": {
          "description": "Template for RFC 9457 `detail`, sent to the client. Placeholders: {field}, {field|count}, {field|default:text}. Literal braces: {{ and }}.",
          "$ref": "#/$defs/text",
          "minLength": 1,
          "maxLength": 1024
        },
        "log": {
          "description": "Template for the server log line, never sent. May use private fields. Defaults to `detail`.",
          "$ref": "#/$defs/text",
          "minLength": 1,
          "maxLength": 2048
        },
        "description": { "$ref": "#/$defs/text", "maxLength": 4096 },
        "retryAfter": {
          "description": "Name of a required public integer field holding seconds; the HTTP mapper sets the Retry-After header from it.",
          "$ref": "#/$defs/fieldName"
        },
        "deprecated": { "$ref": "#/$defs/deprecated" },
        "data": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/fieldName" },
          "maxProperties": 64,
          "additionalProperties": { "$ref": "#/$defs/field" }
        }
      }
    },
    "namedType": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["enum"],
          "properties": {
            "description": { "$ref": "#/$defs/text" },
            "enum": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "maxLength": 64 }
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["fields"],
          "properties": {
            "description": { "$ref": "#/$defs/text" },
            "fields": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 64,
              "propertyNames": { "$ref": "#/$defs/fieldName" },
              "additionalProperties": { "$ref": "#/$defs/field" }
            }
          }
        }
      ]
    },
    "fieldType": {
      "description": "A primitive, `array`, or the name of an entry in `types`.",
      "type": "string",
      "anyOf": [
        { "enum": ["string", "integer", "int64", "number", "boolean", "date-time", "array"] },
        { "pattern": "^[A-Z][A-Za-z0-9]*$" }
      ]
    },
    "itemType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "anyOf": [
            { "enum": ["string", "integer", "int64", "number", "boolean", "date-time"] },
            { "pattern": "^[A-Z][A-Za-z0-9]*$" }
          ]
        },
        "format": { "enum": ["uuid", "date", "uri"] }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/fieldType" },
        "format": { "enum": ["uuid", "date", "uri"] },
        "items": { "$ref": "#/$defs/itemType" },
        "optional": { "type": "boolean" },
        "private": { "type": "boolean" },
        "description": { "$ref": "#/$defs/text", "maxLength": 1024 },
        "example": { "type": ["string", "number", "boolean"] },
        "deprecated": { "$ref": "#/$defs/deprecated" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "array" } } },
          "then": { "required": ["items"] },
          "else": { "not": { "required": ["items"] } }
        },
        {
          "if": { "required": ["format"] },
          "then": { "properties": { "type": { "const": "string" } } }
        }
      ]
    }
  }
}
