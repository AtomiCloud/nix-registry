{
  "title": "Checkout overview",
  "uid": "payments-checkout-overview",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      { "type": "datasource", "name": "ds", "query": "prometheus" },
      {
        "type": "query",
        "name": "provider",
        "query": { "query": "label_values(checkout_charges_total, payment_provider)", "refId": "q" },
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Charges by outcome",
      "interval": "1m",
      "datasource": { "type": "prometheus", "uid": "fixture-metrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(checkout_charges_total{\"payment.provider\"=~\"$provider\"}[$__rate_interval]))"
        }
      ]
    }
  ]
}
