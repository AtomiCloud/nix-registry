# Without a contract the static check cannot judge; live, the underscore selector and grouping are compared
# with the seed's label names: one failure per query, naming the stored (dotted) spelling.
mode: live
exit: 1
contains: alerts/where-from/critical.yaml rule where-from-critical query A
contains: [label-spelling]
contains: write "durian.cloud.service"
contains: write "durian.cloud.platform"
