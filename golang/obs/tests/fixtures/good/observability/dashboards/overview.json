{
  "title": "Checkout overview",
  "uid": "payments-checkout-overview",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      { "type": "datasource", "name": "ds", "query": "prometheus" },
      {
        "type": "query",
        "name": "provider",
        "query": { "query": "label_values(checkout_charges_total, payment_provider)", "refId": "q" },
        "includeAll": true,
        "multi": true
      },
      { "type": "custom", "name": "route", "query": "/charge,/refund", "current": { "value": "/charge" } }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Charges by outcome",
      "interval": "1m",
      "datasource": { "type": "prometheus", "uid": "primordial-metrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(checkout_charges_total{payment_provider=~\"$provider\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route=\"$route\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "row",
      "title": "Logs",
      "panels": [
        {
          "id": 4,
          "type": "logs",
          "title": "Failed charges",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "primordial-logs" },
          "targets": [
            {
              "refId": "A",
              "queryType": "instant",
              "expr": "\"durian.cloud/event\":=\"checkout.charge.failed\" payment.provider:~\"$provider\""
            }
          ]
        }
      ]
    }
  ]
}
