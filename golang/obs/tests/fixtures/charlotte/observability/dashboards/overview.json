{
  "title": "Observability Overview",
  "uid": "primordial-box-overview",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "pod",
        "label": "Pod",
        "query": "label_values(kube_pod_container_status_restarts_total, pod)",
        "includeAll": true,
        "multi": true,
        "datasource": { "type": "prometheus", "uid": "primordial-metrics" }
      },
      {
        "type": "textbox",
        "name": "filter",
        "label": "Filter (regex)",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Restarts by pod",
      "datasource": { "type": "prometheus", "uid": "primordial-metrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{cluster=\"primordial\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Request error ratio",
      "datasource": { "type": "prometheus", "uid": "primordial-metrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(charlotte_requests_total{outcome=\"error\"}[$__rate_interval])) / sum(rate(charlotte_requests_total[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Crash lines by service",
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "primordial-logs" },
      "targets": [
        {
          "refId": "A",
          "queryType": "stats",
          "expr": "{cluster=\"primordial\"} ~\"(?i)(panic:|fatal error:)\" | stats by (service) count() hits"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Platform errors & crashes",
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "primordial-logs" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "{cluster=\"primordial\",service!~\"logs|traces\"} ~\"(?i)(panic:|fatal error:|panicked|segmentation fault|out of memory|oom-kill)\" ~\"$filter\""
        }
      ]
    }
  ]
}
